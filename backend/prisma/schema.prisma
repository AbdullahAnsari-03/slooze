generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum Country {
  INDIA
  AMERICA
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  role    Role
  country Country

  orders Order[]
}

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  status    String
  country   Country

  user      User     @relation(fields: [userId], references: [id])
}